      "id": 102,
      "type": "stat",
      "title": "Checkouts Started",
      "gridPos": { "x": 6, "y": 99, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM analytics WHERE event_type='start_checkout' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 103,
      "type": "stat",
      "title": "Orders Placed (Paid)",
      "gridPos": { "x": 12, "y": 99, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM orders WHERE status='paid' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },


      "title": "Checkouts Cancelled",
      "gridPos": { "x": 18, "y": 99, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM analytics WHERE event_type='checkout_cancelled' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 105,
      "type": "stat",
      "title": "Checkout Conversion Rate",
      "gridPos": { "x": 0, "y": 104, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ROUND(100 * SUM(CASE WHEN event_type='payment_success' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN event_type='start_checkout' THEN 1 ELSE 0 END),0),1) AS value FROM analytics WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 106,
      "type": "stat",
      "title": "Total Revenue (£)",
      "gridPos": { "x": 6, "y": 104, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT SUM(amount)/100 AS value FROM orders WHERE status='paid' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyGBP" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 107,
      "type": "timeseries",
      "title": "Visits / Checkouts / Orders Over Time",
      "gridPos": { "x": 12, "y": 104, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "name": "MySQL-Ecomm" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at,'1h') AS time, event_type AS metric, COUNT(*) AS value FROM analytics WHERE $__timeFilter(created_at) AND event_type IN ('page_visit','start_checkout','payment_success','checkout_cancelled') GROUP BY time,event_type ORDER BY time"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },


      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT city AS City, region AS Region, country AS Country, COUNT(*) AS Visits FROM geo_tracking WHERE $__timeFilter(created_at) GROUP BY city,region,country ORDER BY Visits DESC LIMIT 10"
        }
      ]

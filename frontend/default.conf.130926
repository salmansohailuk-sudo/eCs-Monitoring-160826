server {

    listen 80;

    server_name _;


    # =====================================================
    # FRONTEND
    # =====================================================

    root /usr/share/nginx/html;

    index index.html;


    # =====================================================
    # FRONTEND ROUTES
    # =====================================================

    location / {

        try_files $uri $uri/ /index.html;

    }


    # =====================================================
    # SUCCESS PAGE
    # =====================================================

    location = /success.html {

        try_files $uri =404;

    }


    # =====================================================
    # CANCEL PAGE
    # =====================================================

    location = /cancel.html {

        try_files $uri =404;

    }


    # =====================================================
    # BACKEND API
    # =====================================================

    location /api/ {

        proxy_pass BACKEND_URL_PLACEHOLDER;

        proxy_http_version 1.1;

        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header X-Forwarded-Port $server_port;

    }


    # =====================================================
    # NGINX PROMETHEUS EXPORTER
    # =====================================================

    location = /nginx_status {

        stub_status;

        access_log off;

        # Restrict to the Docker bridge/overlay network so only the
        # nginx-exporter container (same compose network) can scrape this.
        # Previously "allow all" exposed internal nginx stats to the public
        # internet on port 80 alongside the storefront.
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;

    }


    # =====================================================
    # FRONTEND HEALTH CHECK
    # =====================================================

    location = /health {

        access_log off;

        default_type text/plain;

        return 200 "healthy\n";

    }

}
